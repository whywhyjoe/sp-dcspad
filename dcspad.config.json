{
  "version": 1,
  "frameworks": {
    "prefer": "local",
    "fallbackToCdn": false,
    "items": {
      "pnpjs2": {
        "localUrl": "./lib-mirror/pnp2.bundle.js",
        "cdnUrl": "",
        "probeGlobal": "pnp2",
        "intelligence": [
          "pnpjs-2.15.0"
        ]
      },
      "alpine": {
        "localUrl": "./lib-mirror/alpine.js",
        "cdnUrl": "",
        "probeGlobal": "Alpine",
        "intelligence": [
          "alpine-3"
        ]
      }
    }
  },
  "docs": [
    {
      "id": "design-system-reference",
      "title": "Design system reference",
      "url": "../bsp-design-system/examples/design-system-reference.html",
      "type": "html"
    },
    {
      "id": "illustration-library",
      "title": "Illustration library",
      "url": "../bsp-design-system/bmo-illustration-library/gallery.html",
      "type": "html"
    }
  ],
  "copilot": {
    "enabled": true,
    "url": "https://m365.cloud.microsoft/chat"
  },
  "workbench": {
    "url": "https://tenant.sharepoint.com/sites/YourSite/_layouts/15/SPWorkbench.aspx"
  },
  "assets": {
    "designSystem": {
      "prefer": "local",
      "localBaseUrl": "../bsp-design-system/",
      "hostedBaseUrl": "",
      "intelligence": [
        "bsp-design"
      ],
      "files": {
        "tokens": "colors_and_type.css",
        "components": "components.css",
        "bundle": "styles.css",
        "editorial": "editorial.css",
        "iconSprite": "bmo-icons.svg",
        "iconElement": "fluent-icon.js",
        "componentExamples": "examples/components.html",
        "editorialExamples": "examples/editorial-components.html"
      }
    },
    "fluentIcons": {
      "prefer": "local",
      "localBaseUrl": "../bsp-fluent-icon-lib/",
      "hostedBaseUrl": "",
      "intelligence": [
        "fluent-icons"
      ],
      "files": {
        "catalog": "fluent-font-library.json",
        "svgFolder": "svg/",
        "fontFolder": "fonts/",
        "regularCss": "fonts/FluentSystemIcons-Regular.css",
        "filledCss": "fonts/FluentSystemIcons-Filled.css",
        "lightCss": "fonts/FluentSystemIcons-Light.css"
      },
      "runtime": {
        "enabled": true,
        "cssFiles": [
          "regularCss",
          "filledCss",
          "lightCss"
        ],
        "fluentIconElement": true
      }
    }
  }
}
