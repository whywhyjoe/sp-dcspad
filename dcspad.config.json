{
  "version": 1,
  "siteURL": "/sites/NewNerve/FCUPortal/",
  "frameworks": {
    "prefer": "local",
    "fallbackToCdn": false,
    "items": {
      "pnpjs2": {
        "localUrl": "code/lib/pnp2.bundle.js",
        "cdnUrl": "",
        "probeGlobal": "pnp2",
        "intelligence": [
          "pnpjs-2.15.0"
        ]
      },
      "alpine": {
        "localUrl": "code/lib/alpine.js",
        "cdnUrl": "",
        "probeGlobal": "Alpine",
        "intelligence": [
          "alpine-3"
        ]
      },
      "bsp-design": {
        "localUrl": "Code/bsp-design/styles.css",
        "cdnUrl": ""
      },
      "fluent": {
        "localUrl": "Code/fluent-icons/fonts/FluentSystemIcons-All.css",
        "cdnUrl": ""
      }
    }
  },
  "docs": [
    {
      "id": "design-system-reference",
      "title": "BSP Design System reference",
      "url": "code/bsp-design/index.html",
      "type": "html"
    },
    {
      "id": "fluent-icons",
      "title": "Fluent Icons library",
      "url": "code/fluent-icons/index.html",
      "type": "html"
    },
        {
      "id": "abacus-icons",
      "title": "BMO 'Abacus' icons library",
      "url": "code/bsp-design/abacus-icons/index.html",
      "type": "html"
    },
        {
      "id": "spot-illustrarions",
      "title": "BMO spot illustraions library",
      "url": "code/bsp-design/spot-illustrations/index.html",
      "type": "html"
    }
  ],
  "copilot": {
    "enabled": true,
    "url": "https://m365.cloud.microsoft/chat"
  },
  "workbench": {
    "url": "https://nervedotnet.sharepoint.com/sites/NewNerve/SitePages/tools/SPWorkbench.aspx"
  },
  "assets": {
    "designSystem": {
      "prefer": "local",
      "localBaseUrl": "code/bsp-design/",
      "hostedBaseUrl": "",
      "intelligence": [
        "bsp-design"
      ],
      "files": {
        "tokens": "colors_and_type.css",
        "components": "components.css",
        "bundle": "styles.css",
        "editorial": "editorial.css",
        "iconSprite": "bmo-icons.svg",
        "iconElement": "fluent-icon.js",
        "componentExamples": "examples/components.html",
        "editorialExamples": "examples/editorial-components.html"
      }
    },
    "fluentIcons": {
      "prefer": "local",
      "localBaseUrl": "code/fluent-icons/",
      "hostedBaseUrl": "",
      "intelligence": [
        "fluent-icons"
      ],
      "files": {
        "catalog": "fluent-icon-library.json",
        "svgFolder": "svg/",
        "fontFolder": "fonts/",
        "regularCss": "fonts/FluentSystemIcons-Regular.css",
        "filledCss": "fonts/FluentSystemIcons-Filled.css",
        "lightCss": "fonts/FluentSystemIcons-Light.css"
      },
      "runtime": {
        "enabled": false,
        "cssFiles": [
          "regularCss",
          "filledCss",
          "lightCss"
        ],
        "fluentIconElement": true
      }
    }
  }
}
